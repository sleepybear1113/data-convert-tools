{
  "name": "data-convert-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-only DBF, SQLite, XLSX and CSV conversion workspace",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/playwright.mjs test",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-sql": "6.10.0",
    "buffer": "6.0.3",
    "codemirror": "6.0.2",
    "decimal.js": "10.6.0",
    "iconv-lite": "0.7.3",
    "naive-ui": "2.45.3",
    "papaparse": "5.7.0",
    "pinia": "4.1.0",
    "sql.js": "1.15.2",
    "string_decoder": "1.3.0",
    "vue": "3.5.45",
    "xlsx": "file:third_party/sheetjs/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
